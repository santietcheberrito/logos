# Conexión de BACKEND a Postgres. En Supabase: Project Settings → Database → Connection string
# (usar el "Session pooler" o la conexión directa). Salta RLS: solo para el MCP Server y el dashboard.
DATABASE_URL=postgresql://postgres.<proyecto>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Embeddings: openai (producción) o local (solo pruebas, sin red)
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
# Distancia coseno máxima para que un fragmento cuente en la búsqueda semántica (0 a 2)
SIMILITUD_MAX_DISTANCIA=0.68
# ts_rank mínimo para que cuente una coincidencia de texto
TEXTO_MIN_RANK=0.025

# Solo para correr el MCP por stdio (Claude Desktop / Cursor): token del agente
LOGOS_TOKEN=

# Dashboard detrás de HTTPS (cookie segura)
DASHBOARD_HTTPS=0
